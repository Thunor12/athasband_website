# Points the shop / checkout pages at band_payment_store.
# Never put PayPal client id/secret here — those stay on the payment store.
#
# Local + PayPal sandbox (payment store on this machine):
#   PUBLIC_PAYMENT_API_URL=http://127.0.0.1:3000
#
# Production payment store (default for `astro build` / deploy when unset):
PUBLIC_PAYMENT_API_URL=https://band-payment-store.thunor97.net
