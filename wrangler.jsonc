{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "athas-website",
  "compatibility_date": "2026-08-08",
  // Keep workers.dev as a backup URL.
  "workers_dev": true,
  // Static Astro build output — no Worker script needed.
  "assets": {
    "directory": "./dist"
  },
  // Served under the existing thunor97.net Cloudflare zone.
  "routes": [
    { "pattern": "athasband.thunor97.net", "custom_domain": true }
  ]
}
